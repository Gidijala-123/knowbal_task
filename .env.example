# ---------------------------------------------------------------------------
# Copy to .env (`cp .env.example .env`) and fill in. Server-side ONLY.
# Nothing in this file is ever shipped to the browser bundle.
# Test/sandbox values only. Never put live keys here.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
PORT=8787
# Origin of the Vite portal; used for CORS and Stripe success/cancel redirects
APP_BASE_URL=http://localhost:5173
# Shared secret for /api/admin/* (send as `x-admin-key`). Generate: openssl rand -hex 24
ADMIN_API_KEY=change-me-long-random-string

# --- Stripe (test mode: keys start with sk_test / whsec) --------------------
STRIPE_SECRET_KEY=sk_test_xxx
# Printed by `stripe listen` when it starts. Dashboard webhook secrets differ.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional. Left empty the server builds price_data from the `documents` row,
# which is the required behaviour (amount never comes from the client).
STRIPE_PRICE_ID=

# --- Supabase --------------------------------------------------------------
SUPABASE_URL=https://xxxx.supabase.co
# Public key, also used by the browser (safe to expose, RLS enforces access).
SUPABASE_ANON_KEY=eyJhbGciOi...
# SECRET. Server only. Bypasses RLS; never import it into web/.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Zoho CRM (Developer Edition, REST API v2 over OAuth2) -----------------
# Self-client generated in Setup > Developer Hub > API Access > Server-based
# web application. Redirect URI must match exactly what you register.
ZOHO_CLIENT_ID=xxx
ZOHO_CLIENT_SECRET=xxx
# Long-lived token produced by `npm run zoho:bootstrap` (one time).
ZOHO_REFRESH_TOKEN=xxx
# Data centre of YOUR org — pick one: .com / .eu / .in / .com.au / .cn
# e.g. https://accounts.zoho.eu  +  https://www.zohoapis.eu/crm/v2
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# Base API URL *including* the org id, path `/Deals/{id}` is appended by code.
# e.g. https://www.zohoapis.com/crm/v2/4153149000000000
ZOHO_API_URL=https://www.zohoapis.com/crm/v2/YOUR_ZOHO_ORG_ID
# Stage API name that means "paid" in your org (Setup > Deals > Stage).
ZOHO_PAID_STAGE=Closed Won
# Only used by `npm run zoho:bootstrap`. Must match the redirect URI you
# register on the Zoho self-client exactly.
ZOHO_REDIRECT_URI=http://localhost:8790/zoho/callback
# Demo switch: makes every Zoho call fail as if the API were down, so you can
# show access still being granted while crm_sync stays pending.
ZOHO_SIMULATE_FAILURE=false

# --- Seeding (test data only) ----------------------------------------------
# Password for the two seeded demo logins. Test accounts, no real value.
SEED_CLIENT_PASSWORD=TestAccess!234
# Deal ids copied from your Zoho org after creating the two sample deals.
ZOHO_DEAL_ID_CLIENT_A=
ZOHO_DEAL_ID_CLIENT_B=

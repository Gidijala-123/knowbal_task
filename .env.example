# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values.
# Never commit .env — it is gitignored.
# See README.md section 3 for where to find each value.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
PORT=8787
# Origin of the Vite portal — used for CORS and Stripe success/cancel redirects.
APP_BASE_URL=http://localhost:5173
# Shared secret for /api/admin/* routes. Send as x-admin-key header.
# Generate with: npm run env:make-admin-key
ADMIN_API_KEY=change-me-at-least-8-chars
# 0 locally. Set to 1 when deployed behind a single reverse proxy.
TRUST_PROXY=0

# --- Stripe (test mode — keys start with sk_test_ / whsec_) ---------------
# Stripe Dashboard → Test mode → Developers → API keys → Secret key
STRIPE_SECRET_KEY=sk_test_xxx
# Printed by `npm run stripe:listen` when it starts. NOT the Dashboard webhook secret.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional. Leave empty — the server builds price_data from the documents row.
STRIPE_PRICE_ID=

# --- Supabase --------------------------------------------------------------
# Project Settings → API → Project URL
SUPABASE_URL=https://xxxx.supabase.co
# Project Settings → API Keys → Publishable key (safe to expose, RLS enforces access)
SUPABASE_ANON_KEY=sb_publishable_xxx
# Project Settings → API Keys → Secret key (server only — never put in web/)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
# Project Settings → Database → Connection string → URI (session pooler)
# Only used by `npm run db:migrate` — the server never reads this.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Zoho CRM (Developer Edition, OAuth2) ----------------------------------
# api-console.zoho.<dc> → Self Client → Client ID
ZOHO_CLIENT_ID=1000.xxx
# Same page → Client Secret
ZOHO_CLIENT_SECRET=xxx
# Generated once by `npm run zoho:bootstrap` — paste the printed value here.
ZOHO_REFRESH_TOKEN=1000.xxx
# Match your data centre: accounts.zoho.com | .eu | .in | .com.au | .cn
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# https://www.zohoapis.<dc>/crm/v2/<your-org-id>
# Org ID is the number in your Zoho browser URL (e.g. org60094789527)
ZOHO_API_URL=https://www.zohoapis.com/crm/v2/YOUR_ZOHO_ORG_ID
# Stage picklist value that means paid in your org (Setup → Deals → Stage)
ZOHO_PAID_STAGE=Closed Won
# Must match the redirect URI registered on the Self Client exactly.
ZOHO_REDIRECT_URI=http://localhost:8790/zoho/callback
# Set to true to simulate Zoho being down — access still granted, sync stays pending.
ZOHO_SIMULATE_FAILURE=false

# --- Seeding (test data only) ----------------------------------------------
# Password for the two seeded demo accounts (client-a / client-b @example.com)
SEED_CLIENT_PASSWORD=TestAccess!234
# Deal IDs from Zoho. Open each Deal → copy the last number from the browser URL.
# Leave empty and re-run `npm run seed` after adding them.
ZOHO_DEAL_ID_CLIENT_A=
ZOHO_DEAL_ID_CLIENT_B=

# --- Testing ---------------------------------------------------------------
# Not read by the server. Set to 1 to run the live RLS integration suite.
# Requires a real Supabase project with migrations applied.
RUN_INTEGRATION=0

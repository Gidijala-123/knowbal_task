# These are the ONLY variables that reach the browser bundle. Both are public
# values by design: the anon key is useless without a user JWT, and RLS decides
# what a JWT may read. Never add a service role or Stripe key here.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
VITE_API_BASE_URL=http://localhost:8787

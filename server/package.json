{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'test/rlsIsolation.integration.test.ts'",
    "test:integration": "vitest run test/rlsIsolation.integration.test.ts",
    "seed": "tsx src/scripts/seed.ts",
    "db:migrate": "tsx src/scripts/applyMigrations.ts",
    "env:check": "tsx src/scripts/checkEnv.ts",
    "env:make-admin-key": "tsx src/scripts/makeAdminKey.ts",
    "retry-crm-sync": "tsx src/scripts/retryCrmSync.ts",
    "zoho:bootstrap": "tsx src/scripts/zohoBootstrap.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "stripe": "^17.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
